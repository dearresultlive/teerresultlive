---
import { COMMUNITY_LINKS } from '../config/community';
const year = new Date().getFullYear();
---

<footer class="bg-white border-t border-slate-200 text-slate-500 py-6 sm:py-8 text-xs mt-12 shadow-xs">
  <div class="max-w-4xl mx-auto px-4 space-y-4">
    
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 border-b border-slate-100 pb-4">
      <div class="flex items-center gap-2">
        <span class="text-xl">🎯</span>
        <span class="font-black text-slate-900 text-sm">TEER RESULT LIVE</span>
      </div>

      <div class="flex items-center gap-3 text-[11px] font-semibold text-slate-600 flex-wrap justify-center">
        <a href="/" class="hover:text-amber-600 transition-colors">Home</a>
        <span>•</span>
        <a href="/shillong-teer" class="hover:text-amber-600 transition-colors">Shillong Teer</a>
        <span>•</span>
        <a href="/khanapara-teer" class="hover:text-amber-600 transition-colors">Khanapara Teer</a>
        <span>•</span>
        <a href="/juwai-teer" class="hover:text-amber-600 transition-colors">Juwai Teer</a>
        <span>•</span>
        <a href="/dream-numbers" class="hover:text-amber-600 transition-colors">Dream Numbers</a>
        <span>•</span>
        <a href="/previous-results" class="hover:text-amber-600 transition-colors">Archive</a>
      </div>
    </div>

    <!-- Official Community Channels -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-2.5 bg-slate-50 border border-slate-200/80 rounded-xl p-3 text-xs">
      <div class="flex items-center gap-2">
        <span class="text-lg">🔔</span>
        <span class="font-bold text-slate-800">Official Result Channels:</span>
      </div>
      <div class="flex items-center gap-2">
        <a
          href={COMMUNITY_LINKS.telegram}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 bg-[#229ED9] hover:bg-[#1b8bc2] text-white font-bold text-xs px-3 py-1.5 rounded-lg transition-all shadow-2xs active:scale-95"
        >
          <span>✈️</span>
          <span>Telegram Channel</span>
        </a>
        <a
          href={COMMUNITY_LINKS.whatsappChannel}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold text-xs px-3 py-1.5 rounded-lg transition-all shadow-2xs active:scale-95"
        >
          <span>📢</span>
          <span>WhatsApp Channel</span>
        </a>
      </div>
    </div>

    <!-- Statutory Disclaimer -->
    <div class="space-y-1.5 text-[10px] text-slate-500 leading-relaxed">
      <p>
        <strong>Legal Disclaimer:</strong> Teer is a traditional game of archery governed under the Meghalaya Amusements and Betting Tax (Amendment) Act 1982. This website (<a href="https://teerresultlive.in" class="text-slate-700 font-semibold hover:underline">teerresultlive.in</a>) is strictly an informational and news reporting portal publishing public archery contest outcomes. We do not organize, facilitate, or promote any gambling or betting activities.
      </p>
      <p>
        Users are advised to check and verify winning target numbers with official Khasi Hills Archery Sports Association (KHASA) notices.
      </p>
    </div>

    <!-- Copyright & Policy Links -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-2 pt-2 text-[11px] text-slate-500">
      <p>© {year} Teer Result Live. All rights reserved.</p>
      <div class="flex items-center gap-3">
        <a href="/about" class="hover:text-slate-800 transition-colors">About Us</a>
        <a href="/contact" class="hover:text-slate-800 transition-colors">Contact</a>
        <a href="/privacy-policy" class="hover:text-slate-800 transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-slate-800 transition-colors">Terms of Service</a>
        <a href="/disclaimer" class="hover:text-slate-800 transition-colors">Disclaimer</a>
      </div>
    </div>

  </div>
</footer>
