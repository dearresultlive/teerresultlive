---
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  publishDate?: string;
}

const {
  title = "Shillong Teer Result Today Live • Khanapara, Juwai Teer Hit Numbers | Teer Result Live",
  description = "Get today's fastest Shillong Teer result live, Khanapara Teer, Juwai Teer, previous hit numbers, target common numbers (House & Ending), and complete dream number list.",
  canonicalUrl,
  publishDate = new Date().toISOString()
} = Astro.props;

const currentPath = Astro.url.pathname;
const cleanPath = currentPath === '/' ? '/' : currentPath.replace(/\/+$/, '');
const host = 'https://teerresultlive.in';
const cleanCanonical = canonicalUrl || `${host}${cleanPath}`;

// 1. Structured Data: WebSite & SearchAction
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Teer Result Live",
  "alternateName": ["Shillong Teer Result", "Khanapara Teer", "Teer Live", "তিৰ রেজাল্ট লাইভ", "शिलांग तीर"],
  "url": host,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${host}/dream-numbers?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};

// 2. Structured Data: NewsArticle with Compliant Image Metadata
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": title,
  "description": description,
  "datePublished": publishDate,
  "dateModified": new Date().toISOString(),
  "mainEntityOfPage": cleanCanonical,
  "image": {
    "@type": "ImageObject",
    "url": `${host}/og-image.jpg`,
    "width": 1200,
    "height": 630,
    "caption": "Shillong & Khanapara Teer Live Results Board",
    "creator": {
      "@type": "Organization",
      "name": "Teer Result Live"
    },
    "creditText": "Teer Result Live",
    "copyrightNotice": "© 2026 Teer Result Live. All rights reserved.",
    "license": `${host}/terms`,
    "acquireLicensePage": `${host}/terms`
  },
  "author": {
    "@type": "Organization",
    "name": "Teer Result Live",
    "url": host
  },
  "publisher": {
    "@type": "Organization",
    "name": "Teer Result Live",
    "logo": {
      "@type": "ImageObject",
      "url": `${host}/favicon.svg`,
      "width": 100,
      "height": 100,
      "caption": "Teer Result Live Official Logo",
      "creator": {
        "@type": "Organization",
        "name": "Teer Result Live"
      },
      "creditText": "Teer Result Live",
      "copyrightNotice": "© 2026 Teer Result Live. All rights reserved.",
      "license": `${host}/terms`,
      "acquireLicensePage": `${host}/terms`
    }
  }
};

// 3. Structured Data: FAQPage Schema (Search-friendly rich snippet triggers)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the shooting schedule for Shillong Teer today?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Shillong Teer 1st Round (FR) is declared at 3:45 PM IST and 2nd Round (SR) is declared at 4:45 PM IST from Monday to Saturday at Polo Ground, Shillong."
      }
    },
    {
      "@type": "Question",
      "name": "What time is Khanapara and Juwai Teer result declared?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Juwai Teer 1st Round is announced at 1:45 PM and 2nd Round at 2:30 PM. Khanapara Teer 1st Round is announced at 4:00 PM and 2nd Round at 4:30 PM IST."
      }
    },
    {
      "@type": "Question",
      "name": "How is the Teer winning result calculated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Registered archers shoot arrows at cylindrical targets. The total arrows hitting the target are counted, and the last two digits of the count determine the winning number (e.g. 842 hits = winning number 42)."
      }
    },
    {
      "@type": "Question",
      "name": "What are House and Ending in Teer common numbers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In two-digit numbers, 'House' refers to the tens digit (e.g., in 74, House is 7), and 'Ending' refers to the units digit (in 74, Ending is 4). Target common numbers predict probable house and ending frequencies."
      }
    }
  ]
};

// 4. Structured Data: BreadcrumbList Schema
const pathSegments = cleanPath.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": host
  }
];

if (pathSegments.length > 0) {
  const pageName = pathSegments[0]
    .replace(/-/g, ' ')
    .replace(/\b\w/g, l => l.toUpperCase());
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 2,
    "name": pageName,
    "item": cleanCanonical
  });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={cleanCanonical} />

  <!-- Progressive Web App (PWA) Configuration -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Teer Live" />
  <meta name="application-name" content="Teer Live" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Search Engine Robots: STRICTLY LOCKED TO NOINDEX UNTIL USER ENABLES INDEXING -->
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
  <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={cleanCanonical} />
  <meta property="og:site_name" content="Teer Result Live" />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:image" content={`${host}/og-image.jpg`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Shillong and Khanapara Teer Live Results Board" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${host}/og-image.jpg`} />

  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@600;700;800&display=swap" rel="stylesheet" />

  <!-- Pre-configured Structured Data (Rich SERP Cards ready for when indexing is enabled) -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</head>
