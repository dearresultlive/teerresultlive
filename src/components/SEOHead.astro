---
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  publishDate?: string;
}

const {
  title = "Shillong Teer Result Today Live • Khanapara, Juwai Teer Hit Numbers | Teer Result Live",
  description = "Get today's fastest Shillong Teer result live, Khanapara Teer, Juwai Teer, previous hit numbers, target common numbers (House & Ending), and complete dream number list.",
  canonicalUrl,
  publishDate = new Date().toISOString()
} = Astro.props;

const currentPath = Astro.url.pathname;
const cleanPath = currentPath === '/' ? '/' : currentPath.replace(/\/+$/, '');
const host = 'https://teerresultlive.in';
const cleanCanonical = canonicalUrl || `${host}${cleanPath}`;

// Structured Data: WebSite & SearchAction
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Teer Result Live",
  "alternateName": ["Shillong Teer Result", "Khanapara Teer", "Teer Live", "তিৰ রেজাল্ট লাইভ"],
  "url": host,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${host}/dream-numbers?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};

// Structured Data: NewsArticle with Compliant Image Metadata
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": title,
  "description": description,
  "datePublished": publishDate,
  "dateModified": new Date().toISOString(),
  "mainEntityOfPage": cleanCanonical,
  "image": {
    "@type": "ImageObject",
    "url": `${host}/og-image.jpg`,
    "width": 1200,
    "height": 630,
    "caption": "Shillong & Khanapara Teer Live Results Board",
    "creator": {
      "@type": "Organization",
      "name": "Teer Result Live"
    },
    "creditText": "Teer Result Live",
    "copyrightNotice": "© 2026 Teer Result Live. All rights reserved.",
    "license": `${host}/terms`,
    "acquireLicensePage": `${host}/terms`
  },
  "author": {
    "@type": "Organization",
    "name": "Teer Result Live",
    "url": host
  },
  "publisher": {
    "@type": "Organization",
    "name": "Teer Result Live",
    "logo": {
      "@type": "ImageObject",
      "url": `${host}/favicon.svg`,
      "width": 100,
      "height": 100,
      "caption": "Teer Result Live Official Logo",
      "creator": {
        "@type": "Organization",
        "name": "Teer Result Live"
      },
      "creditText": "Teer Result Live",
      "copyrightNotice": "© 2026 Teer Result Live. All rights reserved.",
      "license": `${host}/terms`,
      "acquireLicensePage": `${host}/terms`
    }
  }
};
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={cleanCanonical} />

  <!-- Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#ffffff" />

  <!-- Robots (Locked to noindex until explicitly enabled) -->
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
  <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={cleanCanonical} />
  <meta property="og:site_name" content="Teer Result Live" />
  <meta property="og:image" content={`${host}/og-image.jpg`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Shillong and Khanapara Teer Live Results Board" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${host}/og-image.jpg`} />

  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@600;700;800&display=swap" rel="stylesheet" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</head>
