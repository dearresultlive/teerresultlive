---
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  publishDate?: string;
}

const {
  title = "Shillong Teer Result Today Live • Khanapara, Juwai Teer Hit Numbers | Teer Result Live",
  description = "Get today's fastest Shillong Teer result live, Khanapara Teer, Juwai Teer, previous hit numbers, target common numbers (House & Ending), and complete dream number list.",
  canonicalUrl,
  publishDate = new Date().toISOString()
} = Astro.props;

const currentPath = Astro.url.pathname;
const cleanPath = currentPath === '/' ? '/' : currentPath.replace(/\/+$/, '');
const host = 'https://teerresultlive.in';
const cleanCanonical = canonicalUrl || `${host}${cleanPath}`;

// 1. Structured Data: WebSite & SearchAction
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Teer Result Live",
  "alternateName": [
    "Shillong Teer Result",
    "Khanapara Teer",
    "Welcome Teer Result",
    "Guwahati Teer",
    "Assam Meghalaya Teer",
    "Teer Live",
    "শিলং তীর রেজাল্ট",
    "খানাপাড়া তীর",
    "তিৰ ৰিজাল্ট",
    "शिलांग तीर रिजल्ट"
  ],
  "url": host,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${host}/dream-numbers?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};

// Determine page category for contextual schemas
const isSportsPage = ['/', '/shillong-teer', '/khanapara-teer', '/juwai-teer', '/shillong-night-teer'].includes(cleanPath);
const isNewsArticle = isSportsPage || ['/previous-results', '/dream-numbers'].includes(cleanPath);
const isAboutPage = cleanPath === '/about';
const isContactPage = cleanPath === '/contact';

// 2. Structured Data: NewsArticle (for content / results pages)
const articleSchema = isNewsArticle ? {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": title,
  "description": description,
  "datePublished": publishDate,
  "dateModified": new Date().toISOString(),
  "mainEntityOfPage": cleanCanonical,
  "image": {
    "@type": "ImageObject",
    "url": `${host}/og-image.jpg`,
    "width": 1200,
    "height": 630,
    "caption": "Shillong & Khanapara Teer Live Results Board",
    "creator": {
      "@type": "Organization",
      "name": "Teer Result Live"
    },
    "creditText": "Teer Result Live",
    "copyrightNotice": "© 2026 Teer Result Live. All rights reserved.",
    "license": `${host}/terms`,
    "acquireLicensePage": `${host}/terms`
  },
  "author": {
    "@type": "Organization",
    "name": "Teer Result Live",
    "url": host
  },
  "publisher": {
    "@type": "Organization",
    "name": "Teer Result Live",
    "logo": {
      "@type": "ImageObject",
      "url": `${host}/favicon.svg`,
      "width": 100,
      "height": 100,
      "caption": "Teer Result Live Official Logo",
      "creator": {
        "@type": "Organization",
        "name": "Teer Result Live"
      },
      "creditText": "Teer Result Live",
      "copyrightNotice": "© 2026 Teer Result Live. All rights reserved.",
      "license": `${host}/terms`,
      "acquireLicensePage": `${host}/terms`
    }
  }
} : null;

// 3. Structured Data: Contextual FAQPage Schema
let pageFaqs: Array<{ q: string; a: string }> = [];

if (cleanPath === '/shillong-teer') {
  pageFaqs = [
    {
      q: "What time is Shillong Teer result declared today?",
      a: "Shillong Teer 1st Round (FR) is declared at 3:45 PM IST and the 2nd Round (SR) is declared at 4:45 PM IST, Monday to Saturday."
    },
    {
      q: "Where is Shillong Teer conducted?",
      a: "Shillong Teer is officially conducted at the Polo Ground in Shillong, Meghalaya by the Khasi Hills Archery Sports Association (KHASA)."
    },
    {
      q: "How is the Shillong Teer winning number decided?",
      a: "50 licensed traditional archers shoot bamboo arrows at a cylindrical target. The arrows that hit are counted, and the last two digits of the total count form the winning number (e.g. 748 hits = winning number 48)."
    },
    {
      q: "Is Shillong Teer held on Sundays?",
      a: "No, Sunday is an official archery holiday. Shillong Teer operates only from Monday to Saturday."
    },
    {
      q: "What is Shillong Welcome Teer Result?",
      a: "Shillong Welcome Teer refers to the official opening daily archery contest scores and advance target predictions announced at Polo Ground, Shillong."
    },
    {
      q: "What is Shillong Teer Counter Result?",
      a: "Shillong Teer Counter Result refers to the official winning hit numbers verified by referees and posted across authorized archery counters and booking stalls across Meghalaya and Assam immediately after the arrow count at Polo Ground."
    }
  ];
} else if (cleanPath === '/khanapara-teer') {
  pageFaqs = [
    {
      q: "What time is Khanapara Teer result declared today?",
      a: "Khanapara Teer 1st Round is announced at 4:00 PM IST and 2nd Round at 4:30 PM IST from Monday to Saturday."
    },
    {
      q: "Where does Khanapara Teer take place?",
      a: "Khanapara Teer takes place in Khanapara, Ri-Bhoi district, located on the Assam-Meghalaya border."
    },
    {
      q: "Why is Khanapara Teer also called Guwahati Teer?",
      a: "Khanapara Teer is located directly adjacent to Guwahati at the Assam-Meghalaya border gate, so players across Assam commonly refer to it as Guwahati Teer or Assam Meghalaya Teer."
    },
    {
      q: "Where can I get Khanapara Teer hit number alerts?",
      a: "You can receive instant Khanapara Teer 1st Round (4:00 PM) and 2nd Round (4:30 PM) hit numbers directly on your phone by joining our official Telegram channel or using our live board 1-click share."
    },
    {
      q: "What are Khanapara Teer common numbers?",
      a: "Common numbers are target predictions calculated based on past frequency charts, house/ending trends, and formula models."
    },
    {
      q: "Is Khanapara Teer open on Sundays?",
      a: "No. Khanapara Teer is closed on Sundays in accordance with state sports regulations. Shooting resumes every Monday at 3:48 PM IST."
    },
    {
      q: "What is the payout rate for Khanapara Teer?",
      a: "Single numbers pay 80:1 (₹800 on a ₹10 ticket), House or Ending pays 9:1, and a forecast on both rounds pays 4,000:1."
    }
  ];
} else if (cleanPath === '/shillong-night-teer') {
  pageFaqs = [
    {
      q: "What time is Shillong Night Teer result declared today?",
      a: "Shillong Night Teer 1st Round is declared at 10:30 PM IST and 2nd Round at 11:30 PM IST, Monday to Saturday."
    },
    {
      q: "When does Night Teer shooting start?",
      a: "Night archery shooting begins at 10:18 PM IST for the First Round and 11:18 PM IST for the Second Round."
    },
    {
      q: "Where is Shillong Night Teer conducted?",
      a: "Shillong Night Teer is conducted under illuminated archery grounds in Shillong, Meghalaya."
    },
    {
      q: "Is Shillong Night Teer open on Sundays?",
      a: "No, Sunday is an official archery holiday across Meghalaya. Night Teer operates from Monday to Saturday."
    },
    {
      q: "What is the payout for Shillong Night Teer?",
      a: "A direct 2-digit number win pays 80:1 (₹80 for ₹1 bet), while House or Ending pays 9:1, and Forecast pays 4,000:1."
    }
  ];
} else if (cleanPath === '/juwai-teer') {
  pageFaqs = [
    {
      q: "What time is Juwai Teer result declared today?",
      a: "Juwai Teer 1st Round is declared at 1:45 PM IST and 2nd Round at 2:30 PM IST, Monday to Saturday."
    },
    {
      q: "Where is Juwai Teer conducted?",
      a: "Juwai Teer is conducted in the historic town of Juwai, West Jaintia Hills district, Meghalaya."
    },
    {
      q: "How is the Juwai winning number calculated?",
      a: "Archers shoot cane arrows at a circular target. The total number of arrows hitting the target are counted, and the last two digits become the official winning number (e.g. 596 arrows = number 96)."
    },
    {
      q: "Is Juwai Teer held on Sundays?",
      a: "No, Sunday is an official archery holiday across Meghalaya. Juwai Teer is conducted only from Monday to Saturday."
    },
    {
      q: "What is the payout for Juwai Teer?",
      a: "A direct 2-digit number win pays 80:1 (₹80 for ₹1 bet), while House or Ending pays 9:1 (₹9 for ₹1 bet)."
    }
  ];
} else if (cleanPath === '/dream-numbers') {
  pageFaqs = [
    {
      q: "How do Teer dream numbers work?",
      a: "In traditional Khasi folklore, dreams are believed to correspond to specific numbers. For example, dreaming of a snake often maps to House 9 (ending 09, 19, etc.), while water relates to 4 or 7."
    },
    {
      q: "How can I find my dream number?",
      a: "Search your dream symbol (e.g., fish, tiger, flying, wedding) in our directory above to see the traditional Direct, House, and Ending numbers."
    },
    {
      q: "What should I do if I see multiple symbols in one dream?",
      a: "If your dream features both a snake (House 9) and water (House 4), look for overlap or cross-pairings such as 49 or 94. Focus on the most vivid object of the dream."
    },
    {
      q: "Can I use these dream numbers for Khanapara and Juwai Teer?",
      a: "Yes. The symbolic dream numbers dictionary is universally followed across Northeast India, including Shillong Teer, Khanapara Teer (Guwahati), Juwai Teer, and Night Teer."
    },
    {
      q: "Can dream numbers guarantee a 100% win?",
      a: "No. Dream numbers are rooted in centuries-old tribal folklore and cultural tradition. Actual winning numbers in Shillong, Khanapara, and Juwai depend solely on the verified arrow counts recorded by licensed referees."
    }
  ];
} else if (cleanPath === '/previous-results') {
  pageFaqs = [
    {
      q: "Where can I view old Shillong and Khanapara Teer hit records?",
      a: "Our archive table provides complete historical First Round and Second Round results for Shillong, Khanapara, and Juwai Teer with instant 2-digit number search."
    },
    {
      q: "How often do Teer hit numbers repeat?",
      a: "While every archery contest is an independent event, players study hit frequency charts and recurring house/ending patterns across the previous 30 to 90 days."
    }
  ];
} else if (cleanPath === '/') {
  pageFaqs = [
    {
      q: "What is the shooting schedule for Shillong Teer today?",
      a: "Shillong Teer 1st Round (FR) is declared at 3:45 PM IST and 2nd Round (SR) at 4:45 PM IST from Monday to Saturday at Polo Ground, Shillong."
    },
    {
      q: "What time is Khanapara and Juwai Teer result declared?",
      a: "Juwai Teer 1st Round is announced at 1:45 PM and 2nd Round at 2:30 PM. Khanapara Teer 1st Round is announced at 4:00 PM and 2nd Round at 4:30 PM IST."
    },
    {
      q: "How is the Teer winning result calculated?",
      a: "Registered archers shoot arrows at cylindrical targets. The total arrows hitting the target are counted, and the last two digits of the count determine the winning number."
    },
    {
      q: "What are House and Ending in Teer common numbers?",
      a: "In two-digit numbers, 'House' refers to the tens digit (in 74, House is 7), and 'Ending' refers to the units digit (in 74, Ending is 4)."
    },
    {
      q: "What is Shillong Welcome Teer Result and Advance Number?",
      a: "Shillong Welcome Teer refers to the official opening archery round scores and daily advance target predictions announced by authorized Khasi archery associations at Polo Ground."
    },
    {
      q: "Is Khanapara Teer also called Guwahati Teer or Assam Meghalaya Teer?",
      a: "Yes, Khanapara Teer is widely known as Guwahati Teer and Assam Meghalaya Teer Result because the archery grounds are located at Khanapara gate along the Assam-Meghalaya interstate border."
    },
    {
      q: "Where can I get the fastest 0-second Teer result today live?",
      a: "You can check 0-second verified Teer result today live on this portal for Shillong (3:45 PM & 4:45 PM), Khanapara Guwahati (4:00 PM & 4:30 PM), and Juwai (1:45 PM & 2:30 PM) direct from Polo Ground."
    },
    {
      q: "How to check Shillong Teer result in Bengali (শিলং তীর রেজাল্ট লাইভ)?",
      a: "আমাদের ওয়েবসাইটে প্রতিদিনের শিলং তীর রেজাল্ট (Shillong Teer Result), খানাপাড়া তীর এবং জওয়াই তীরের ১ম ও ২য় রাউন্ডের লাইভ ফলাফল সবার আগে সরাসরি প্রকাশিত হয়।"
    }
  ];
}

const faqSchema = pageFaqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": pageFaqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
} : null;

// 4. Structured Data: BreadcrumbList Schema
const pathSegments = cleanPath.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": host
  }
];

if (pathSegments.length > 0) {
  const pageName = pathSegments[0]
    .replace(/-/g, ' ')
    .replace(/\b\w/g, l => l.toUpperCase());
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 2,
    "name": pageName,
    "item": cleanCanonical
  });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};

// 5. Structured Data: Contextual SportsEvent Schema (Only for sports result pages)
const todayISTDate = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Kolkata' }).format(new Date());

let sportsEventSchema = null;
if (isSportsPage) {
  let eventName = "Shillong Teer Traditional Archery Competition";
  let eventDesc = "Daily official traditional archery contest conducted by Khasi Hills Archery Sports Association (KHASA) at Polo Ground, Shillong.";
  let startTime = `${todayISTDate}T15:45:00+05:30`;
  let endTime = `${todayISTDate}T16:45:00+05:30`;
  let locationName = "Polo Ground (KHASA Official Archery Grounds)";
  let locality = "Shillong";
  let region = "Meghalaya";
  let postalCode = "793001";
  let performerName = "Khasi Hills Traditional Archery Clubs";

  if (cleanPath === '/khanapara-teer') {
    eventName = "Khanapara Teer Traditional Archery Competition";
    eventDesc = "Daily official traditional archery contest conducted at Khanapara, Ri-Bhoi on the Assam-Meghalaya border.";
    startTime = `${todayISTDate}T16:00:00+05:30`;
    endTime = `${todayISTDate}T16:30:00+05:30`;
    locationName = "Khanapara Archery Grounds";
    locality = "Ri-Bhoi";
    region = "Meghalaya";
    postalCode = "793101";
    performerName = "Assam-Meghalaya Border Traditional Archery Clubs";
  } else if (cleanPath === '/juwai-teer') {
    eventName = "Juwai Teer Traditional Archery Competition";
    eventDesc = "Daily official traditional archery contest conducted in Juwai, West Jaintia Hills, Meghalaya.";
    startTime = `${todayISTDate}T13:45:00+05:30`;
    endTime = `${todayISTDate}T14:30:00+05:30`;
    locationName = "Juwai Archery Grounds";
    locality = "Juwai";
    region = "Meghalaya";
    postalCode = "793150";
    performerName = "West Jaintia Hills Traditional Archery Clubs";
  } else if (cleanPath === '/shillong-night-teer') {
    eventName = "Shillong Night Teer Traditional Archery Competition";
    eventDesc = "Daily official nocturnal traditional archery contest conducted under floodlit grounds in Shillong, Meghalaya.";
    startTime = `${todayISTDate}T22:30:00+05:30`;
    endTime = `${todayISTDate}T23:30:00+05:30`;
    locationName = "Shillong Night Archery Grounds";
    locality = "Shillong";
    region = "Meghalaya";
    postalCode = "793001";
    performerName = "Shillong Night Traditional Archery Clubs";
  }

  sportsEventSchema = {
    "@context": "https://schema.org",
    "@type": "SportsEvent",
    "name": eventName,
    "description": eventDesc,
    "image": [
      `${host}/og-image.jpg`
    ],
    "startDate": startTime,
    "endDate": endTime,
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "location": {
      "@type": "Place",
      "name": locationName,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": locality,
        "addressRegion": region,
        "postalCode": postalCode,
        "addressCountry": "IN"
      }
    },
    "organizer": {
      "@type": "SportsOrganization",
      "name": cleanPath === '/khanapara-teer' ? "Khanapara Archery Association" : cleanPath === '/juwai-teer' ? "Juwai Archery Club" : cleanPath === '/shillong-night-teer' ? "Shillong Night Traditional Archery Association" : "Khasi Hills Archery Sports Association (KHASA)",
      "url": host
    },
    "performer": {
      "@type": "SportsTeam",
      "name": performerName
    },
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "INR",
      "availability": "https://schema.org/InStock",
      "url": cleanCanonical,
      "validFrom": `${todayISTDate}T06:00:00+05:30`
    }
  };
}

// 6. AboutPage & ContactPage Schemas
const aboutPageSchema = isAboutPage ? {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Teer Result Live",
  "description": description,
  "url": cleanCanonical,
  "mainEntity": {
    "@type": "Organization",
    "name": "Teer Result Live",
    "url": host,
    "logo": `${host}/favicon.svg`
  }
} : null;

const contactPageSchema = isContactPage ? {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Teer Result Live",
  "description": description,
  "url": cleanCanonical,
  "mainEntity": {
    "@type": "Organization",
    "name": "Teer Result Live",
    "url": host,
    "email": "support@teerresultlive.in"
  }
} : null;
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="Shillong teer result, Shillong teer counter result, shillong teer result today live, Khanapara teer result, Juwai teer result, Shillong night teer, meghalaya teer result live, assam meghalaya teer result, teer counter live, welcome teer result, teer common numbers, teer house ending, teer dream numbers, শিলং তীর রেজাল্ট, খানাপাড়া তীর, তিৰ ৰিজাল্ট, शिलांग तीर" />
  <link rel="canonical" href={cleanCanonical} />

  <!-- Google News & RSS 2.0 Feed Discovery -->
  <link rel="alternate" type="application/rss+xml" title="Teer Result Live • Official Google News & RSS Feed" href={`${host}/rss.xml`} />

  <!-- Progressive Web App (PWA) Configuration -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Teer Live" />
  <meta name="application-name" content="Teer Live" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Search Engine Robots: Fully Enabled for Indexing, Discover & Rich Snippets -->
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

  <!-- Google Search Console Verification Meta Tag (If provided via ENV) -->
  {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
    <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />
  )}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={cleanCanonical} />
  <meta property="og:site_name" content="Teer Result Live" />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:image" content={`${host}/og-image.jpg`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Shillong and Khanapara Teer Live Results Board" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${host}/og-image.jpg`} />

  <!-- Non-Blocking Typography: System UI First with Background Web Font Enhancement -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <script is:inline>
    (function() {
      function loadCustomFonts() {
        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@700&display=swap';
        document.head.appendChild(link);
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadCustomFonts);
      } else {
        window.addEventListener('load', loadCustomFonts);
      }
    })();
  </script>

  <!-- Google Analytics 4 (GA4): Asynchronously deferred for 100/100 Core Web Vitals -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-JR3S2ZXES7', { send_page_view: true });

    function loadGA() {
      if (window.__gaLoaded) return;
      window.__gaLoaded = true;
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-JR3S2ZXES7';
      document.head.appendChild(s);
    }

    if (document.readyState === 'complete') {
      setTimeout(loadGA, 1200);
    } else {
      window.addEventListener('load', () => setTimeout(loadGA, 1200));
    }
  </script>

  <!-- Structured Data Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  {sportsEventSchema && <script type="application/ld+json" set:html={JSON.stringify(sportsEventSchema)} />}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  {aboutPageSchema && <script type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />}
  {contactPageSchema && <script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />}
</head>
