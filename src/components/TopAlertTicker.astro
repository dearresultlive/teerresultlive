---
import { COMMUNITY_LINKS } from '../config/community';
---

<div class="bg-gradient-to-r from-emerald-800 via-slate-900 to-sky-900 text-white text-[11px] sm:text-xs py-2 px-3 border-b border-emerald-500/30 shadow-xs relative z-30">
  <div class="max-w-4xl mx-auto flex items-center justify-between gap-2.5">
    
    <!-- Left: Eye-catching announcement with pulsating icon -->
    <div class="flex items-center gap-2 min-w-0">
      <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 text-xs shrink-0 animate-pulse">
        🎯
      </span>
      <span class="font-bold text-slate-100 truncate text-[11px] sm:text-xs">
        <strong class="text-amber-300 font-black">Today's Target Common Numbers &amp; House-Ending</strong> • আজকের লাইভ ফলাফল ও কমন চার্ট
      </span>
    </div>

    <!-- Right: 1-Tap Fast Buttons for WhatsApp & Telegram -->
    <div class="flex items-center gap-1.5 shrink-0">
      <a
        href={COMMUNITY_LINKS.whatsappChannel}
        target="_blank"
        rel="nofollow noopener noreferrer"
        class="inline-flex items-center gap-1 bg-[#25D366] hover:bg-[#20ba59] active:scale-95 text-white font-black text-[10px] sm:text-[11px] px-2.5 py-1 rounded-full shadow-2xs transition-all"
        title="Join WhatsApp Channel"
      >
        <span>💬</span>
        <span class="hidden xs:inline">WhatsApp</span>
        <span class="xs:hidden">WA</span>
      </a>
      <a
        href={COMMUNITY_LINKS.telegram}
        target="_blank"
        rel="nofollow noopener noreferrer"
        class="inline-flex items-center gap-1 bg-[#229ED9] hover:bg-[#1b8bc2] active:scale-95 text-white font-black text-[10px] sm:text-[11px] px-2.5 py-1 rounded-full shadow-2xs transition-all"
        title="Join Telegram Channel"
      >
        <span>✈️</span>
        <span class="hidden xs:inline">Telegram</span>
        <span class="xs:hidden">TG</span>
      </a>
    </div>

  </div>
</div>
