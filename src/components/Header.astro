---
const currentPath = Astro.url.pathname;
---

<header class="bg-slate-900 border-b border-slate-800 text-white sticky top-0 z-50 backdrop-blur-md bg-slate-900/95">
  <div class="max-w-4xl mx-auto px-3 sm:px-4 py-2.5 flex items-center justify-between">
    
    <!-- Logo & Brand -->
    <a href="/" class="flex items-center gap-2 group">
      <div class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-lg">
        🎯
      </div>
      <div>
        <span class="text-sm sm:text-base font-black tracking-tight text-white block leading-tight group-hover:text-amber-400 transition-colors">
          TEER RESULT <span class="text-amber-400">LIVE</span>
        </span>
        <span class="text-[9px] text-slate-400 block tracking-wider uppercase font-semibold">
          Shillong • Khanapara • Juwai
        </span>
      </div>
    </a>

    <!-- Top Live Badge & Nav -->
    <div class="flex items-center gap-2 sm:gap-3">
      <div class="hidden sm:inline-flex items-center gap-1.5 bg-emerald-950/80 border border-emerald-500/40 text-emerald-400 text-xs font-bold px-2.5 py-1 rounded-full shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Live Board</span>
      </div>

      <nav class="flex items-center gap-1 text-xs font-bold text-slate-300">
        <a 
          href="/" 
          class={`px-2.5 py-1 rounded-lg transition-colors ${currentPath === '/' ? 'bg-amber-500/20 text-amber-300' : 'hover:bg-slate-800 hover:text-white'}`}
        >
          Live
        </a>
        <a 
          href="/dream-numbers" 
          class={`px-2.5 py-1 rounded-lg transition-colors ${currentPath === '/dream-numbers' ? 'bg-amber-500/20 text-amber-300' : 'hover:bg-slate-800 hover:text-white'}`}
        >
          Dream Numbers
        </a>
        <a 
          href="/previous-results" 
          class={`px-2.5 py-1 rounded-lg transition-colors ${currentPath === '/previous-results' ? 'bg-amber-500/20 text-amber-300' : 'hover:bg-slate-800 hover:text-white'}`}
        >
          Archive
        </a>
      </nav>
    </div>

  </div>
</header>
