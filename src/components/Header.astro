---
import { COMMUNITY_LINKS } from '../config/community';
const currentPath = Astro.url.pathname;
---

<header class="bg-white/95 border-b border-slate-200 text-slate-900 sticky top-0 z-40 backdrop-blur-md shadow-xs">
  <div class="max-w-4xl mx-auto px-3 sm:px-4 py-2 flex items-center justify-between">
    
    <!-- Logo & Brand -->
    <a href="/" class="flex items-center gap-2 group">
      <div class="w-8 h-8 rounded-lg bg-amber-50 border border-amber-300 flex items-center justify-center text-lg shadow-xs">
        🎯
      </div>
      <div>
        <span class="text-sm sm:text-base font-black tracking-tight text-slate-900 block leading-tight group-hover:text-amber-600 transition-colors">
          TEER RESULT <span class="text-amber-600">LIVE</span>
        </span>
        <span class="text-[9px] text-slate-500 block tracking-wider uppercase font-semibold">
          Shillong • Khanapara • Juwai
        </span>
      </div>
    </a>

    <!-- Top Controls: Live Badge + WhatsApp Alerts + Mobile Menu -->
    <div class="flex items-center gap-1.5 sm:gap-2.5">
      
      <!-- Live Indicator Badge: visible on mobile & desktop -->
      <div class="inline-flex items-center gap-1.5 bg-emerald-50 border border-emerald-300 text-emerald-700 text-[11px] sm:text-xs font-black px-2 sm:px-2.5 py-1 rounded-full shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="hidden xs:inline">Live Sync</span>
        <span class="xs:hidden">Live</span>
      </div>

      <!-- Top Corner WhatsApp Alerts Channel Button -->
      <a
        href={COMMUNITY_LINKS.whatsappChannel}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 bg-[#25D366] hover:bg-[#20bd5a] text-white text-[11px] sm:text-xs font-black px-2.5 py-1 rounded-lg shadow-2xs transition-all active:scale-95 group"
        title="Official WhatsApp Alerts Channel"
        aria-label="Join WhatsApp Alerts Channel"
      >
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-80"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
        </span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 20.15C10.58 20.15 9.13 19.76 7.86 19L7.56 18.82L4.44 19.64L5.27 16.59L5.07 16.27C4.24 14.95 3.8 13.44 3.8 11.91C3.8 7.37 7.5 3.67 12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.59 20.15 12.05 20.15ZM16.57 14.33C16.32 14.21 15.11 13.61 14.88 13.53C14.66 13.44 14.49 13.4 14.33 13.65C14.16 13.89 13.69 14.44 13.55 14.61C13.4 14.77 13.26 14.79 13.01 14.67C12.76 14.54 11.96 14.28 11.01 13.43C10.27 12.77 9.77 11.96 9.62 11.71C9.48 11.46 9.61 11.33 9.73 11.21C9.84 11.1 9.98 10.92 10.1 10.78C10.23 10.63 10.27 10.53 10.35 10.36C10.44 10.2 10.39 10.05 10.33 9.93C10.27 9.81 9.77 8.58 9.57 8.08C9.37 7.6 9.17 7.66 9.02 7.65C8.88 7.65 8.71 7.64 8.55 7.64C8.38 7.64 8.11 7.7 7.89 7.95C7.66 8.19 7.03 8.79 7.03 10C7.03 11.21 7.91 12.38 8.03 12.55C8.16 12.71 9.77 15.2 12.23 16.26C12.82 16.51 13.27 16.66 13.63 16.78C14.22 16.97 14.75 16.94 15.18 16.88C15.65 16.81 16.63 16.29 16.84 15.71C17.04 15.13 17.04 14.63 16.98 14.53C16.92 14.43 16.82 14.45 16.57 14.33Z"/>
        </svg>
        <span class="font-extrabold leading-none">Alerts</span>
      </a>

      <!-- Mobile Menu Trigger (Opens Features & Community Drawer) -->
      <button
        type="button"
        id="mobile-drawer-trigger"
        class="md:hidden flex items-center justify-center w-8 h-8 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 transition-colors cursor-pointer"
        aria-label="Open Features Menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="4" y1="6" x2="20" y2="6"/>
          <line x1="4" y1="12" x2="20" y2="12"/>
          <line x1="4" y1="18" x2="20" y2="18"/>
        </svg>
      </button>

      <!-- Desktop Only Navigation (Hidden on mobile to avoid duplicate bottom dock) -->
      <nav class="hidden md:flex items-center gap-1 text-xs font-bold text-slate-600 border-l border-slate-200 pl-3 ml-1">
        <a 
          href="/" 
          class={`px-2.5 py-1 rounded-lg transition-colors ${currentPath === '/' ? 'bg-amber-100 text-amber-900 font-black' : 'hover:bg-slate-100 hover:text-slate-900'}`}
        >
          Live
        </a>
        <a 
          href="/#common-numbers" 
          class="px-2.5 py-1 rounded-lg transition-colors hover:bg-slate-100 hover:text-slate-900"
        >
          Targets
        </a>
        <a 
          href="/dream-numbers" 
          class={`px-2.5 py-1 rounded-lg transition-colors ${currentPath === '/dream-numbers' ? 'bg-amber-100 text-amber-900 font-black' : 'hover:bg-slate-100 hover:text-slate-900'}`}
        >
          Dream Numbers
        </a>
        <a 
          href="/previous-results" 
          class={`px-2.5 py-1 rounded-lg transition-colors ${currentPath === '/previous-results' ? 'bg-amber-100 text-amber-900 font-black' : 'hover:bg-slate-100 hover:text-slate-900'}`}
        >
          Archive
        </a>
      </nav>

    </div>

  </div>
</header>

<script>
  const triggerBtn = document.getElementById('mobile-drawer-trigger');
  if (triggerBtn) {
    triggerBtn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-mobile-drawer'));
    });
  }
</script>
