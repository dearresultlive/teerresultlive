---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

// Cuelinks MoneyView Tracking Link
const affiliateUrl = "https://linksredirect.com/?cid=333938&source=linkkit&url=https%3A%2F%2Fplay.google.com%2Fstore%2Fapps%2Fdetails%3Fid%3Dcom.whizdm.moneyview.loans";
---

<aside 
  class={`relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950 text-white p-4 sm:p-5 shadow-xl border-2 border-amber-400/40 ring-4 ring-amber-400/10 ${className}`}
  aria-label="Instant Personal Loan Assistance"
>
  <!-- Ambient Gold & Emerald Glow Highlights -->
  <div class="absolute -right-8 -top-8 w-36 h-36 bg-amber-400/15 rounded-full blur-2xl pointer-events-none"></div>
  <div class="absolute -left-8 -bottom-8 w-36 h-36 bg-emerald-500/15 rounded-full blur-2xl pointer-events-none"></div>

  <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4 relative z-10">
    
    <!-- Left Section: Universal Visual Badges & Clear Offer -->
    <div class="space-y-2 flex-1">
      
      <!-- Top Trust Bar: Universal English & Official Verified Status -->
      <div class="flex items-center gap-2 flex-wrap text-[11px]">
        <span class="inline-flex items-center gap-1.5 bg-emerald-500/25 text-emerald-300 font-black px-2.5 py-0.5 rounded-full border border-emerald-400/40">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          ⚡ Instant Cash Loan
        </span>
        <span class="inline-flex items-center gap-1 bg-amber-400/20 text-amber-300 font-extrabold px-2 py-0.5 rounded-full border border-amber-400/30">
          ⭐ 4.5★ (1 Crore+ Users)
        </span>
        <span class="text-slate-300 font-semibold text-[10px] sm:text-[11px]">
          🛡️ RBI Regulated NBFC
        </span>
      </div>

      <!-- Main Headline: Universal Dual Language (Instant Eye Catch for Any Reader) -->
      <div class="pt-0.5">
        <h3 class="text-base sm:text-lg md:text-xl font-black text-white tracking-tight leading-snug flex items-center flex-wrap gap-2">
          <span>💰 Need Emergency Cash Loan?</span>
          <span class="inline-block bg-gradient-to-r from-amber-300 via-amber-400 to-yellow-400 text-slate-950 font-black px-3 py-1 rounded-xl shadow-md text-sm sm:text-base md:text-lg ring-2 ring-amber-200">
            ₹5,000 to ₹5,00,000
          </span>
        </h3>
        <p class="text-xs sm:text-sm text-amber-200/90 font-bold mt-1">
          জরুরি ক্যাশ লোন দরকার? সরাসরি আপনার ব্যাংক অ্যাকাউন্টে টাকা জমা।
        </p>
      </div>

      <!-- 4 Universal Visual Pills (Easy for Everyone to Understand via Icons) -->
      <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-center gap-2 text-[11px] pt-1">
        <span class="inline-flex items-center gap-1.5 bg-slate-800/90 text-slate-100 px-2.5 py-1.5 rounded-lg border border-slate-700/80 font-semibold shadow-2xs">
          <span>📄</span> Aadhaar &amp; PAN Card
        </span>
        <span class="inline-flex items-center gap-1.5 bg-slate-800/90 text-slate-100 px-2.5 py-1.5 rounded-lg border border-slate-700/80 font-semibold shadow-2xs">
          <span>🏦</span> Direct Bank Transfer
        </span>
        <span class="inline-flex items-center gap-1.5 bg-slate-800/90 text-slate-100 px-2.5 py-1.5 rounded-lg border border-slate-700/80 font-semibold shadow-2xs">
          <span>⚡</span> 2 Mins Online Approval
        </span>
        <span class="inline-flex items-center gap-1.5 bg-slate-800/90 text-slate-100 px-2.5 py-1.5 rounded-lg border border-slate-700/80 font-semibold shadow-2xs">
          <span>🚫</span> No Guarantor (কোনো জামানত নেই)
        </span>
      </div>
    </div>

    <!-- Right Section: Massive High-Converting Gold Action Button -->
    <div class="w-full lg:w-auto shrink-0 flex flex-col items-stretch lg:items-end justify-center gap-1.5 pt-1 lg:pt-0">
      <a
        href={affiliateUrl}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
        class="group relative inline-flex items-center justify-center gap-2 bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-500 hover:from-amber-300 hover:to-yellow-300 active:scale-95 text-slate-950 font-black text-sm sm:text-base px-7 py-3.5 rounded-xl shadow-lg shadow-amber-500/25 transition-all text-center border-2 border-amber-300"
      >
        <span class="text-lg">⚡</span>
        <span class="tracking-tight">Apply Now • লোন নিন (Free)</span>
        <span class="text-lg group-hover:translate-x-1.5 transition-transform">→</span>
      </a>

      <div class="flex items-center justify-between sm:justify-end gap-2 text-[10px] text-slate-400 px-1 font-medium">
        <span>*100% Secure</span>
        <span>•</span>
        <span>No Hidden Charges</span>
        <span>•</span>
        <span>T&amp;C Apply</span>
      </div>
    </div>

  </div>
</aside>
