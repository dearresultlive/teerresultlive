---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

// Cuelinks MoneyView Tracking Link
const affiliateUrl = "https://linksredirect.com/?cid=333938&source=linkkit&url=https%3A%2F%2Fplay.google.com%2Fstore%2Fapps%2Fdetails%3Fid%3Dcom.whizdm.moneyview.loans";
---

<aside 
  class={`relative overflow-hidden rounded-2xl bg-white text-slate-900 p-4 sm:p-5 shadow-sm border-2 border-emerald-500/30 ring-4 ring-emerald-50/70 ${className}`}
  aria-label="Instant Personal Loan Assistance"
>
  <!-- Subtle decorative ambient accents -->
  <div class="absolute -right-8 -top-8 w-36 h-36 bg-emerald-50 rounded-full blur-2xl pointer-events-none"></div>
  <div class="absolute -left-8 -bottom-8 w-36 h-36 bg-amber-50 rounded-full blur-2xl pointer-events-none"></div>

  <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4 relative z-10">
    
    <!-- Left Section: Clean FinTech Offer & Trust Badges -->
    <div class="space-y-2 flex-1">
      
      <!-- Top Trust Bar: Verified FinTech Badges -->
      <div class="flex items-center gap-2 flex-wrap text-[11px]">
        <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-800 font-extrabold px-2.5 py-0.5 rounded-full border border-emerald-300 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          ⚡ Instant Cash Loan
        </span>
        <span class="inline-flex items-center gap-1 bg-amber-50 text-amber-900 font-black px-2 py-0.5 rounded-full border border-amber-300 shadow-2xs">
          ⭐ 4.5★ (1 Crore+ Users)
        </span>
        <span class="text-slate-500 font-bold text-[10px] sm:text-[11px]">
          🛡️ RBI Regulated NBFC Partners
        </span>
      </div>

      <!-- Main Headline: High-Contrast Navy + Golden Cash Highlight -->
      <div class="pt-0.5">
        <h3 class="text-base sm:text-lg md:text-xl font-black text-slate-900 tracking-tight leading-snug">
          <a
            href={affiliateUrl}
            target="_blank"
            rel="sponsored nofollow noopener noreferrer"
            class="hover:text-emerald-700 transition-colors inline-flex items-center flex-wrap gap-2 cursor-pointer"
          >
            <span>💰 Need Emergency Cash Loan?</span>
            <span class="inline-block bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-400 text-slate-950 font-black px-3 py-1 rounded-xl shadow-xs text-sm sm:text-base md:text-lg border border-amber-300">
              ₹5,000 to ₹5,00,000
            </span>
          </a>
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 font-medium mt-1">
          Fast 100% paperless approval • Money directly transferred to your bank account.
        </p>
      </div>

      <!-- 4 Clean Visual Benefit Pills (Clean Bank Style) -->
      <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-center gap-2 text-[11px] pt-1">
        <span class="inline-flex items-center gap-1.5 bg-slate-50 text-slate-800 px-3 py-1.5 rounded-lg border border-slate-200/90 font-bold shadow-2xs">
          <span>📄</span> Only Aadhaar &amp; PAN Card
        </span>
        <span class="inline-flex items-center gap-1.5 bg-slate-50 text-slate-800 px-3 py-1.5 rounded-lg border border-slate-200/90 font-bold shadow-2xs">
          <span>🏦</span> Direct Bank Transfer
        </span>
        <span class="inline-flex items-center gap-1.5 bg-slate-50 text-slate-800 px-3 py-1.5 rounded-lg border border-slate-200/90 font-bold shadow-2xs">
          <span>⚡</span> 2 Mins Online Approval
        </span>
        <span class="inline-flex items-center gap-1.5 bg-slate-50 text-slate-800 px-3 py-1.5 rounded-lg border border-slate-200/90 font-bold shadow-2xs">
          <span>🚫</span> No Guarantor Needed
        </span>
      </div>
    </div>

    <!-- Right Section: Vibrant High-CTR Emerald Action Button -->
    <div class="w-full lg:w-auto shrink-0 flex flex-col items-stretch lg:items-end justify-center gap-1.5 pt-1 lg:pt-0">
      <a
        href={affiliateUrl}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
        class="group relative inline-flex items-center justify-center gap-2 bg-gradient-to-r from-emerald-600 via-emerald-500 to-teal-500 hover:from-emerald-500 hover:to-teal-400 active:scale-95 text-white font-black text-sm sm:text-base px-7 py-3.5 rounded-xl shadow-lg shadow-emerald-600/25 transition-all text-center border border-emerald-400/50 cursor-pointer"
      >
        <span class="text-lg">⚡</span>
        <span class="tracking-tight">Apply Now • Check Loan (Free)</span>
        <span class="text-lg group-hover:translate-x-1.5 transition-transform">→</span>
      </a>

      <div class="flex items-center justify-between sm:justify-end gap-2 text-[10px] text-slate-500 px-1 font-semibold">
        <span>*100% Secure</span>
        <span>•</span>
        <span>Zero Hidden Charges</span>
        <span>•</span>
        <span>T&amp;C Apply</span>
      </div>
    </div>

  </div>
</aside>
