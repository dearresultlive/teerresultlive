---
const currentPath = Astro.url.pathname;
const cleanPath = currentPath === '/' ? '/' : currentPath.replace(/\/+$/, '');

const navItems = [
  {
    name: 'Live Board',
    shortName: 'Live',
    href: '/',
    exact: true,
    icon: 'target'
  },
  {
    name: 'Target Numbers',
    shortName: 'Targets',
    href: '/#common-numbers',
    exact: false,
    icon: 'bullseye'
  },
  {
    name: 'Dream Numbers',
    shortName: 'Dreams',
    href: '/dream-numbers',
    exact: true,
    icon: 'moon'
  },
  {
    name: 'Hit Archive',
    shortName: 'Archive',
    href: '/previous-results',
    exact: true,
    icon: 'chart'
  }
];
---

<nav
  aria-label="Mobile Bottom Navigation"
  class="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-white/95 backdrop-blur-md border-t border-slate-200 shadow-[0_-4px_16px_rgba(15,23,42,0.06)] pb-[max(0.35rem,env(safe-area-inset-bottom))]"
>
  <div class="grid grid-cols-4 h-14 max-w-lg mx-auto px-1">
    {navItems.map((item) => {
      const isActive = item.exact ? cleanPath === item.href : false;

      return (
        <a
          href={item.href}
          class={`flex flex-col items-center justify-center gap-0.5 transition-colors relative py-1 rounded-xl my-1 ${
            isActive
              ? 'text-amber-600 font-black'
              : 'text-slate-500 hover:text-slate-900 font-semibold'
          }`}
        >
          {isActive && (
            <span class="absolute top-0 w-8 h-0.5 rounded-full bg-amber-500"></span>
          )}

          <div class={`w-6 h-6 flex items-center justify-center text-lg ${isActive ? 'scale-110' : ''} transition-transform`}>
            {item.icon === 'target' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <circle cx="12" cy="12" r="6"/>
                <circle cx="12" cy="12" r="2"/>
              </svg>
            )}

            {item.icon === 'bullseye' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <path d="m4.93 4.93 4.24 4.24"/>
                <path d="m14.83 9.17 4.24-4.24"/>
                <path d="m14.83 14.83 4.24 4.24"/>
                <path d="m9.17 14.83-4.24 4.24"/>
                <circle cx="12" cy="12" r="2"/>
              </svg>
            )}

            {item.icon === 'moon' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
              </svg>
            )}

            {item.icon === 'chart' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 3v18h18"/>
                <path d="m19 9-5 5-4-4-3 3"/>
              </svg>
            )}
          </div>

          <span class="text-[10px] tracking-tight leading-none">
            {item.shortName}
          </span>
        </a>
      );
    })}
  </div>
</nav>
