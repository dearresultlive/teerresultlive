---
import Layout from '../layouts/Layout.astro';
import TeerLiveBoard from '../components/TeerLiveBoard';
import CommonNumbersCard from '../components/CommonNumbersCard';
import TeerFormulaCalculator from '../components/TeerFormulaCalculator';
import TeerPrizeCalculator from '../components/TeerPrizeCalculator';
import DreamNumberSearch from '../components/DreamNumberSearch';
import PreviousResultsTable from '../components/PreviousResultsTable';
import PWAInstallBanner from '../components/PWAInstallBanner';
import liveData from '../data/teer_live_results.json';

const todayDateStr = liveData.date.split('-').reverse().join('/');
---

<Layout
  title={`Shillong Teer Result Today Live • ${todayDateStr} | Welcome Teer`}
  description={`Welcome to Teer Result Live (${todayDateStr}): Fastest 0-second Shillong Teer result live for 1st Round (3:45 PM) & 2nd Round (4:45 PM), Khanapara Guwahati, Juwai & Assam Meghalaya hit numbers.`}
>
  <div class="space-y-6">

    <!-- Top Hero Header with Primary Keyword-Rich H1 -->
    <header class="text-center sm:text-left space-y-1 pt-1">
      <h1 class="text-xl sm:text-2xl md:text-3xl font-black text-slate-900 tracking-tight">
        Shillong Teer Result Today Live • {todayDateStr}
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 font-medium">
        Welcome to official live results for Shillong, Khanapara (Guwahati), Juwai &amp; Night Teer direct from Polo Ground.
      </p>
    </header>

    <!-- 1. Real-Time Zero-Refresh Teer Live Results Board -->
    <section id="live-results">
      <TeerLiveBoard client:idle initialData={liveData} />
    </section>

    <!-- App Install Banner (Inline Below Live Board) -->
    <PWAInstallBanner client:idle />

    <!-- 2. Today's Target Common Numbers (Direct, House, Ending) -->
    <section id="common-numbers">
      <CommonNumbersCard client:visible />
    </section>

    <!-- 3. Interactive Formula & Target Calculator -->
    <section id="formula-calculator">
      <TeerFormulaCalculator client:visible />
    </section>

    <!-- 4. Official Teer Prize & Payout Calculator -->
    <section id="prize-calculator">
      <TeerPrizeCalculator client:visible />
    </section>

    <!-- 5. Interactive Teer Dream Number Calculator -->
    <section id="dream-numbers">
      <DreamNumberSearch client:visible />
    </section>

    <!-- 6. Previous Hit Numbers Table -->
    <section id="archive">
      <PreviousResultsTable client:visible />
    </section>

    <!-- 7. In-Depth SEO Gazette & Knowledge Section (Boosts Keyword Rankings) -->
    <section class="bg-white border border-slate-200/90 rounded-2xl p-5 sm:p-7 text-slate-700 space-y-5 text-xs sm:text-sm leading-relaxed shadow-xs">
      
      <header class="border-b border-slate-100 pb-3">
        <h2 class="text-base sm:text-xl font-black text-slate-900 leading-snug">
          Shillong Teer Result Today Live • Khanapara &amp; Juwai Teer Hit Numbers
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          Welcome to Teer Result Live, India's premier fast-reporting portal for Meghalaya archery traditional sports.
        </p>
      </header>

      <div class="space-y-2">
        <h2 class="text-sm sm:text-base font-extrabold text-slate-900">
          What is Shillong Teer &amp; Northeast Traditional Archery?
        </h2>
        <p class="text-slate-600">
          Shillong Teer is a legal, regulated traditional archery contest conducted daily at Polo Ground in Shillong by the Khasi Hills Archery Sports Association (KHASA, consisting of 12 traditional archery clubs). Registered traditional archers shoot bamboo arrows (known traditionally in Khasi as <em>&quot;Ki Khnam&quot;</em>) at cylindrical targets. The total number of arrows hitting the target is counted by licensed officials, and the last two digits of the count determine the winning number for that round. Check out the dedicated <a href="/shillong-teer" class="text-blue-600 font-bold underline hover:text-blue-800">Shillong Teer Counter Result Feed</a> for comprehensive round-by-round statistics.
        </p>
        <p class="text-slate-600">
          Alongside Shillong Teer, the region hosts <a href="/khanapara-teer" class="text-blue-600 font-bold underline hover:text-blue-800">Khanapara Teer Live Result</a> (also known as <strong>Guwahati Teer</strong> or <strong>Assam Meghalaya Teer</strong>) and <a href="/juwai-teer" class="text-blue-600 font-bold underline hover:text-blue-800">Juwai Teer</a> in West Jaintia Hills. Due to its regulated, transparent archery mechanism, the sport commands a dedicated following across Assam, Meghalaya, West Bengal, Tripura, and Nagaland.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        <div class="bg-slate-50/80 p-4 rounded-xl border border-slate-200/80 space-y-2">
          <h3 class="font-black text-slate-900 text-xs uppercase tracking-wide flex items-center gap-1.5">
            <span>⏰</span>
            <span>Official Daily Draw Schedule</span>
          </h3>
          <ul class="text-xs space-y-1.5 text-slate-600 font-medium">
            <li>• <strong class="text-slate-800">Juwai Teer 1st Round:</strong> 1:45 PM</li>
            <li>• <strong class="text-slate-800">Juwai Teer 2nd Round:</strong> 2:30 PM</li>
            <li>• <strong class="text-slate-800">Shillong Teer 1st Round (FR):</strong> 3:45 PM</li>
            <li>• <strong class="text-slate-800">Khanapara Teer 1st Round:</strong> 4:00 PM</li>
            <li>• <strong class="text-slate-800">Khanapara Teer 2nd Round:</strong> 4:30 PM</li>
            <li>• <strong class="text-slate-800">Shillong Teer 2nd Round (SR):</strong> 4:45 PM</li>
            <li>• <strong class="text-slate-800">Shillong Night Teer:</strong> 10:30 PM &amp; 11:30 PM</li>
          </ul>
        </div>

        <div class="bg-slate-50/80 p-4 rounded-xl border border-slate-200/80 space-y-2">
          <h3 class="font-black text-slate-900 text-xs uppercase tracking-wide flex items-center gap-1.5">
            <span>💡</span>
            <span>How Common Numbers &amp; Dreams Work</span>
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed font-medium">
            Target numbers (House, Ending, and Direct) are mathematical predictions calculated from previous hit patterns, sum-difference roots, and traditional Khasi dream interpretations (<em>&quot;Ka Jingphohsniew&quot;</em>). In two-digit results, &quot;House&quot; denotes the tens place digit, while &quot;Ending&quot; denotes the units place digit. Check our <a href="/dream-numbers" class="text-blue-600 font-bold underline hover:text-blue-800">A-Z Teer Dream Number Calculator</a> and <a href="/previous-results" class="text-blue-600 font-bold underline hover:text-blue-800">Historical Previous Results Archive</a> for statistical patterns.
          </p>
        </div>

        <div class="bg-slate-50/80 p-4 rounded-xl border border-slate-200/80 space-y-2">
          <h3 class="font-black text-slate-900 text-xs uppercase tracking-wide flex items-center gap-1.5">
            <span>🏹</span>
            <span>Welcome Teer Result &amp; Morning Schedule</span>
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed font-medium">
            In regional archery culture, players and traditional clubs refer to the day's first official opening scores and greetings as the <strong>Welcome Teer Result</strong> (including <strong>Welcome Teer Result Shillong</strong> and <strong>Welcome Teer Result Night</strong>). Along with morning target calculations, these provide early statistical indicators before afternoon competition rounds commence.
          </p>
        </div>

        <div class="bg-slate-50/80 p-4 rounded-xl border border-slate-200/80 space-y-2">
          <h3 class="font-black text-slate-900 text-xs uppercase tracking-wide flex items-center gap-1.5">
            <span>📍</span>
            <span>Guwahati Teer &amp; Assam Meghalaya Teer Khela</span>
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed font-medium">
            Across Guwahati city and the Brahmaputra valley, <a href="/khanapara-teer" class="text-blue-600 font-bold underline hover:text-blue-800">Khanapara Teer</a> is popularly known as <strong>Guwahati Teer Result</strong>, <strong>Assam Meghalaya Teer</strong>, and <strong>Shillong Guwahati Teer Khela</strong>. Situated right at Khanapara gate along the interstate highway, verified 1st Round (4:00 PM) and 2nd Round (4:30 PM) scores are streamed live daily.
          </p>
        </div>

        <div class="bg-slate-50/80 p-4 rounded-xl border border-slate-200/80 space-y-2 sm:col-span-2">
          <h3 class="font-black text-slate-900 text-xs uppercase tracking-wide flex items-center gap-1.5">
            <span>🌐</span>
            <span>Regional Search Directory • বাংলা • অসমীয়া • हिन्दी</span>
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed font-medium">
            Archery enthusiasts across Assam, West Bengal, Tripura, and Meghalaya search for real-time scores in their local languages. Access our dedicated feeds for 
            <strong class="text-slate-800">শিলং তীর রেজাল্ট লাইভ</strong> (Shillong Teer Live), 
            <strong class="text-slate-800">গুয়াহাটি ও খানাপাড়া তীর রেজাল্ট</strong> (Guwahati &amp; Khanapara Teer), 
            <strong class="text-slate-800">জওয়াই তীর</strong> (Juwai Teer), and 
            <a href="/dream-numbers" class="text-blue-600 font-bold underline hover:text-blue-800">তীর ড্রিম নাম্বার তালিকা (Teer Dream Number List in Bangla &amp; English)</a>. For Hindi readers: <strong class="text-slate-800">शिलांग तीर रिजल्ट और खानपारा तीर रिजल्ट लाइव</strong>.
          </p>
        </div>
      </div>

    </section>

  </div>
</Layout>
