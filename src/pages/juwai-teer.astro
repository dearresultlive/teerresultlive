---
import Layout from '../layouts/Layout.astro';
import liveData from '../data/teer_live_results.json';
import CommonNumbersCard from '../components/CommonNumbersCard';
import PreviousResultsTable from '../components/PreviousResultsTable';

const game = liveData.games.juwai;
const todayDateStr = liveData.date.split('-').reverse().join('/');
---

<Layout
  title={`Juwai Teer Result Today Live (${todayDateStr}) • FR (1:45 PM) & SR (2:30 PM) | Teer Result Live`}
  description={`Live Juwai Teer result today for First Round and Second Round. Check West Jaintia Hills traditional archery hit numbers and common numbers.`}
>
  <div class="space-y-6">
    <header class="bg-gradient-to-r from-slate-900 to-indigo-950 border border-blue-500/30 rounded-2xl p-5 sm:p-7 text-white space-y-3">
      <div class="flex items-center justify-between">
        <h1 class="text-xl sm:text-2xl font-black text-blue-400">
          Juwai Teer Result Today Live • {todayDateStr}
        </h1>
        <span class="text-xs bg-blue-500/20 text-blue-400 font-bold border border-blue-500/40 px-2.5 py-1 rounded-full">
          Live Update
        </span>
      </div>
      <p class="text-xs sm:text-sm text-slate-300">
        Conducted officially in Juwai, West Jaintia Hills, Meghalaya.
      </p>

      <!-- FR & SR Result Box -->
      <div class="grid grid-cols-2 gap-3 pt-2 max-w-md">
        <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-3 text-center">
          <span class="text-xs font-bold text-slate-400 block uppercase">1st Round (1:45 PM)</span>
          <span class="text-3xl sm:text-4xl font-black font-mono text-amber-400 mt-1 block">
            {game.fr}
          </span>
        </div>
        <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-3 text-center">
          <span class="text-xs font-bold text-slate-400 block uppercase">2nd Round (2:30 PM)</span>
          <span class="text-3xl sm:text-4xl font-black font-mono text-emerald-400 mt-1 block">
            {game.sr}
          </span>
        </div>
      </div>
    </header>

    <CommonNumbersCard client:visible />
    <PreviousResultsTable client:visible />
  </div>
</Layout>
