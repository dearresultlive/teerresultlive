---
import Layout from '../layouts/Layout.astro';
import SingleGameLiveCard from '../components/SingleGameLiveCard';
import liveData from '../data/teer_live_results.json';
import archiveData from '../data/previous_teer_archive.json';
import CommonNumbersCard from '../components/CommonNumbersCard';
import PreviousResultsTable from '../components/PreviousResultsTable';
import TeerFormulaCalculator from '../components/TeerFormulaCalculator';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const game = liveData.games.juwai;
const todayDateStr = liveData.date.split('-').reverse().join('/');
const yesterday = (archiveData && archiveData.find((item) => item.date < liveData.date)) || (archiveData && archiveData.length > 0 ? archiveData[0] : null);
const yesterdayDateStr = yesterday ? yesterday.date.split('-').reverse().join('/') : '';
---

<Layout
  title={`Juwai Teer Result Today Live • ${todayDateStr} | Teer Live`}
  description={`Fastest Juwai Teer results today live (${todayDateStr}) for 1st Round (1:45 PM) and 2nd Round (2:30 PM) direct from West Jaintia Hills, Meghalaya.`}
>
  <div class="space-y-6">
    <Breadcrumbs items={[{ name: 'Juwai Teer' }]} />

    <header class="bg-white border-2 border-blue-400 rounded-2xl p-4 sm:p-6 text-slate-900 space-y-3 shadow-xs ring-4 ring-blue-50">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
          Juwai Teer Result <span id="game-live-label">Today Live</span> • <span id="game-date-label">{todayDateStr}</span>
        </h1>
        <span class="text-xs bg-emerald-50 text-emerald-700 font-black border border-emerald-300 px-2.5 py-1 rounded-full shadow-2xs">
          ● West Jaintia Feed
        </span>
      </div>
      <p class="text-xs sm:text-sm text-slate-500 font-medium">
        Conducted officially in the historic town of Juwai, West Jaintia Hills district, Meghalaya.
      </p>

      <!-- Interactive Zero-Refresh Live Result Card with Arrow Counting Animation -->
      <SingleGameLiveCard
        client:load
        gameKey="juwai"
        initialData={liveData}
        themeColor="blue"
      />
    </header>

    <!-- Cross-Game Quick Navigation Hub -->
    <div class="flex items-center gap-1.5 sm:gap-2 overflow-x-auto text-xs py-1 scrollbar-none">
      <span class="text-slate-500 font-bold whitespace-nowrap text-[11px]">Quick Switch:</span>
      <a href="/shillong-teer" class="inline-flex items-center gap-1 bg-white border border-amber-300 text-amber-800 font-bold px-2.5 py-1 rounded-lg hover:bg-amber-50 transition-colors whitespace-nowrap shadow-2xs">
        <span>🎯</span>
        <span>Shillong Teer (3:45 PM)</span>
      </a>
      <a href="/khanapara-teer" class="inline-flex items-center gap-1 bg-white border border-emerald-300 text-emerald-800 font-bold px-2.5 py-1 rounded-lg hover:bg-emerald-50 transition-colors whitespace-nowrap shadow-2xs">
        <span>🎯</span>
        <span>Khanapara Teer (4:00 PM)</span>
      </a>
      <a href="/dream-numbers" class="inline-flex items-center gap-1 bg-white border border-slate-300 text-slate-700 font-bold px-2.5 py-1 rounded-lg hover:bg-slate-50 transition-colors whitespace-nowrap shadow-2xs">
        <span>🌙</span>
        <span>Dream Numbers</span>
      </a>
      <a href="/previous-results" class="inline-flex items-center gap-1 bg-white border border-slate-300 text-slate-700 font-bold px-2.5 py-1 rounded-lg hover:bg-slate-50 transition-colors whitespace-nowrap shadow-2xs">
        <span>📊</span>
        <span>Past Archive</span>
      </a>
    </div>

    <!-- Today's Juwai Common Numbers -->
    <CommonNumbersCard client:visible filterGame="juwai" />

    <!-- Interactive Teer Formula & Target Calculator -->
    <TeerFormulaCalculator client:visible />

    <!-- Historical Hit Archive Filtered to Juwai -->
    <PreviousResultsTable client:visible initialGame="juwai" />

    <!-- In-Depth SEO Gazette for Juwai Teer -->
    <section class="bg-white border border-slate-200/90 rounded-2xl p-5 sm:p-7 text-slate-700 space-y-5 text-xs sm:text-sm leading-relaxed shadow-xs">
      <header class="border-b border-slate-100 pb-3">
        <h2 class="text-base sm:text-xl font-black text-slate-900">
          Guide to Juwai Teer Results (West Jaintia Hills)
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          The earliest daily traditional archery event in Meghalaya, conducted in West Jaintia Hills.
        </p>
      </header>

      <div class="space-y-2">
        <h3 class="text-sm sm:text-base font-extrabold text-slate-900">
          Official Shooting Schedule &amp; Early Afternoon Timings
        </h3>
        <p class="text-slate-600">
          Juwai Teer is unique because its shooting rounds take place earlier in the afternoon than Shillong or Khanapara:
        </p>
        <ul class="list-disc pl-5 space-y-1 text-slate-600">
          <li><strong>First Round (FR):</strong> Archers begin shooting at 1:42 PM IST, with winning numbers declared at <strong>1:45 PM IST</strong>.</li>
          <li><strong>Second Round (SR):</strong> Second round shooting commences at 2:27 PM IST, with final hit numbers tallied at <strong>2:30 PM IST</strong>.</li>
          <li><strong>Days of Operation:</strong> Conducted Monday through Saturday. Sunday is an official archery rest day.</li>
        </ul>
      </div>

      <div class="space-y-2">
        <h3 class="text-sm sm:text-base font-extrabold text-slate-900">
          Cultural Heritage of Jaintia Archery
        </h3>
        <p class="text-slate-600">
          In the Pnar culture of the Jaintia Hills, archery is deeply intertwined with ancient seasonal festivals and rites of passage. Local archers use handcrafted bows fashioned from seasoned hill bamboo and arrows fletched with bird feathers, maintaining indigenous archery mastery passed down across generations.
        </p>
      </div>

      <!-- Official Prize & Payout Structure -->
      <div class="space-y-2">
        <h3 class="text-sm sm:text-base font-extrabold text-slate-900">
          Juwai Teer Official Prize Rates &amp; Returns
        </h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border border-slate-200 rounded-xl overflow-hidden font-mono mt-2">
            <thead class="bg-blue-50 text-blue-950 font-black uppercase text-[11px] border-b border-blue-200">
              <tr>
                <th class="p-2.5 sm:p-3">Bet Type</th>
                <th class="p-2.5 sm:p-3">Sample Bet</th>
                <th class="p-2.5 sm:p-3">Return Ratio</th>
                <th class="p-2.5 sm:p-3">Payout</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
              <tr class="hover:bg-blue-50/40">
                <td class="p-2.5 sm:p-3 font-bold text-slate-900">Single / Direct Hit (FR or SR)</td>
                <td class="p-2.5 sm:p-3">₹10 on "96"</td>
                <td class="p-2.5 sm:p-3 font-black text-emerald-700">80 : 1</td>
                <td class="p-2.5 sm:p-3 font-black text-slate-900">₹800</td>
              </tr>
              <tr class="hover:bg-blue-50/40">
                <td class="p-2.5 sm:p-3 font-bold text-slate-900">House (Tens Digit)</td>
                <td class="p-2.5 sm:p-3">₹10 on House 9</td>
                <td class="p-2.5 sm:p-3 font-black text-emerald-700">9 : 1</td>
                <td class="p-2.5 sm:p-3 font-black text-slate-900">₹90</td>
              </tr>
              <tr class="hover:bg-blue-50/40">
                <td class="p-2.5 sm:p-3 font-bold text-slate-900">Ending (Units Digit)</td>
                <td class="p-2.5 sm:p-3">₹10 on Ending 6</td>
                <td class="p-2.5 sm:p-3 font-black text-emerald-700">9 : 1</td>
                <td class="p-2.5 sm:p-3 font-black text-slate-900">₹90</td>
              </tr>
              <tr class="hover:bg-blue-50/40">
                <td class="p-2.5 sm:p-3 font-bold text-slate-900">Forecast / Both Rounds (FR + SR)</td>
                <td class="p-2.5 sm:p-3">₹10 on FR 96 + SR 74</td>
                <td class="p-2.5 sm:p-3 font-black text-emerald-700">4,000 : 1</td>
                <td class="p-2.5 sm:p-3 font-black text-slate-900">₹40,000</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="space-y-2">
        <h3 class="text-sm sm:text-base font-extrabold text-slate-900">
          How to Use Juwai Results to Find Shillong Common Numbers
        </h3>
        <p class="text-slate-600">
          Because Juwai Teer results are declared at 1:45 PM and 2:30 PM — prior to Shillong Teer (3:45 PM) — many experienced enthusiasts track Juwai winning house and ending digits to evaluate probable numerical shifts for the later afternoon games.
        </p>
      </div>

      <!-- Quick FAQs -->
      <div class="border-t border-slate-100 pt-4 space-y-3">
        <h3 class="text-sm sm:text-base font-extrabold text-slate-900">
          Frequently Asked Questions (FAQs)
        </h3>
        <div class="space-y-2">
          <details class="bg-slate-50 border border-slate-200 rounded-xl p-3 cursor-pointer">
            <summary class="font-bold text-slate-800 text-xs sm:text-sm">Why does Juwai Teer start earlier than other Teer games?</summary>
            <p class="mt-2 text-xs text-slate-600">Juwai clubs follow their traditional early afternoon timetable so local archers and observers can finish before late afternoon tribal sporting matches begin.</p>
          </details>
          <details class="bg-slate-50 border border-slate-200 rounded-xl p-3 cursor-pointer">
            <summary class="font-bold text-slate-800 text-xs sm:text-sm">Where can I see previous Juwai hit results?</summary>
            <p class="mt-2 text-xs text-slate-600">Browse our <a href="/previous-results" class="text-amber-700 font-bold hover:underline">Previous Results Archive</a> or use the table above to filter and inspect historical winning hit records across all months.</p>
          </details>
          <details class="bg-slate-50 border border-slate-200 rounded-xl p-3 cursor-pointer">
            <summary class="font-bold text-slate-800 text-xs sm:text-sm">Is Juwai Teer held on Sundays?</summary>
            <p class="mt-2 text-xs text-slate-600">No. Archery contests are suspended on Sundays across all Meghalaya grounds. Juwai live shooting resumes Monday at 1:42 PM IST.</p>
          </details>
          <details class="bg-slate-50 border border-slate-200 rounded-xl p-3 cursor-pointer">
            <summary class="font-bold text-slate-800 text-xs sm:text-sm">How is the Juwai winning number calculated?</summary>
            <p class="mt-2 text-xs text-slate-600">Archers shoot cane arrows at a circular target. The total number of arrows hitting the target are counted, and the last two digits become the official winning number (e.g. 596 arrows = number 96).</p>
          </details>
        </div>
      </div>
    </section>
  </div>
</Layout>
