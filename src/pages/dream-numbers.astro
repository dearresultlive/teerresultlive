---
import Layout from '../layouts/Layout.astro';
import DreamNumberSearch from '../components/DreamNumberSearch';
---

<Layout
  title="Teer Dream Number List (সপ্নের নম্বর) • Complete A-Z Teer Dream Calculator | Teer Result Live"
  description="Complete Shillong and Khanapara Teer dream numbers list. Find lucky direct, house, and ending numbers for dreams of snakes, water, money, fish, birds, flying, and more."
>
  <div class="space-y-6">
    <header class="bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-6 text-slate-900 space-y-2 shadow-xs">
      <h1 class="text-xl sm:text-2xl font-black text-slate-900 flex items-center gap-2">
        <span>🌙</span>
        <span>Teer Dream Number Directory &amp; Calculator (সপ্নের নম্বর)</span>
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
        In Khasi archery culture, dreams have been correlated with traditional symbols and numbers for over a century. Use our interactive tool below to look up your dream in English, Bengali (বাংলা), or Hindi (हिंदी) to find the traditional Direct, House, and Ending target numbers.
      </p>
    </header>

    <DreamNumberSearch client:load />
  </div>
</Layout>
