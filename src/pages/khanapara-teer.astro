---
import Layout from '../layouts/Layout.astro';
import SingleGameLiveCard from '../components/SingleGameLiveCard';
import liveData from '../data/teer_live_results.json';
import archiveData from '../data/previous_teer_archive.json';
import CommonNumbersCard from '../components/CommonNumbersCard';
import PreviousResultsTable from '../components/PreviousResultsTable';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const game = liveData.games.khanapara;
const todayDateStr = liveData.date.split('-').reverse().join('/');
const yesterday = (archiveData && archiveData.find((item) => item.date < liveData.date)) || (archiveData && archiveData.length > 0 ? archiveData[0] : null);
const yesterdayDateStr = yesterday ? yesterday.date.split('-').reverse().join('/') : '';
---

<Layout
  title={`Khanapara Teer Result Today Live • Guwahati & Assam Meghalaya (${todayDateStr})`}
  description={`Get fastest official Khanapara Teer result today live (${todayDateStr}) for 1st Round (4:00 PM) & 2nd Round (4:30 PM). Verified Guwahati Teer & Assam Meghalaya hit numbers.`}
>
  <div class="space-y-6">
    <Breadcrumbs items={[{ name: 'Khanapara Teer' }]} />

    <header class="bg-white border-2 border-emerald-400 rounded-2xl p-5 sm:p-7 text-slate-900 space-y-3 shadow-xs ring-4 ring-emerald-50">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
          Khanapara Teer Result <span id="game-live-label">Today Live</span> • <span id="game-date-label">{todayDateStr}</span>
        </h1>
        <span class="text-xs bg-emerald-50 text-emerald-700 font-black border border-emerald-300 px-2.5 py-1 rounded-full shadow-2xs">
          ● Guwahati &amp; Assam Border
        </span>
      </div>
      <p class="text-xs sm:text-sm text-slate-500 font-medium">
        Conducted officially at Khanapara, Ri-Bhoi district along the Assam-Meghalaya interstate boundary. Also widely followed as <strong>Guwahati Teer</strong> and <strong>Assam Meghalaya Teer</strong>.
      </p>

      <!-- Interactive Zero-Refresh Live Result Card with Arrow Counting Animation -->
      <SingleGameLiveCard
        client:load
        gameKey="khanapara"
        initialData={liveData}
        themeColor="emerald"
      />
    </header>

    <CommonNumbersCard client:visible />
    <PreviousResultsTable client:visible />

    <!-- In-Depth SEO Gazette for Khanapara Teer -->
    <section class="bg-white border border-slate-200/90 rounded-2xl p-5 sm:p-7 text-slate-700 space-y-5 text-xs sm:text-sm leading-relaxed shadow-xs">
      <header class="border-b border-slate-100 pb-3">
        <h2 class="text-base sm:text-xl font-black text-slate-900">
          Guide to Khanapara Teer (Assam Teer) Results
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          Historical border archery tournament conducted in the Ri-Bhoi district of Meghalaya.
        </p>
      </header>

      <div class="space-y-2">
        <h3 class="text-sm sm:text-base font-extrabold text-slate-900">
          Official Shooting Schedule &amp; Timings
        </h3>
        <p class="text-slate-600">
          Khanapara Teer (popularly known across the region as <em>Assam Teer</em> due to its proximity to Guwahati) runs six days a week from Monday to Saturday:
        </p>
        <ul class="list-disc pl-5 space-y-1 text-slate-600">
          <li><strong>First Round (FR):</strong> Targets are positioned at 3:45 PM, and the official result is declared at <strong>4:00 PM IST</strong>.</li>
          <li><strong>Second Round (SR):</strong> The concluding round begins promptly at 4:15 PM, with declared hit numbers announced at <strong>4:30 PM IST</strong>.</li>
          <li><strong>Sunday Closure:</strong> In line with traditional sporting customs, no archery competitions are held on Sundays.</li>
        </ul>
      </div>

      <div class="space-y-2">
        <h3 class="text-sm sm:text-base font-extrabold text-slate-900">
          Archery Grounds &amp; Geographic Significance
        </h3>
        <p class="text-slate-600">
          Khanapara is strategically situated in Ri-Bhoi district right across the border from Guwahati, Assam. The competition brings together skilled archers from across Khasi, Jaintia, and neighbouring plains communities, practicing centuries-old indigenous archery craft.
        </p>
      </div>

      <div class="space-y-2">
        <h3 class="text-sm sm:text-base font-extrabold text-slate-900">
          How to Calculate Khanapara Common Target Numbers
        </h3>
        <p class="text-slate-600">
          Many enthusiasts analyze the relationship between Shillong FR results and Khanapara numbers. Common analytical methods include:
        </p>
        <ul class="list-disc pl-5 space-y-1 text-slate-600">
          <li><strong>House Ending Pairs:</strong> Tracking previous week trends for recurring tens and units digits.</li>
          <li><strong>Previous Hit Analysis:</strong> Checking our <a href="/previous-results" class="text-amber-700 font-bold hover:underline">archive records</a> to spot numbers that haven't appeared in over 30 days.</li>
          <li><strong>Dream Number Correlation:</strong> Cross-referencing morning dreams with the <a href="/dream-numbers" class="text-amber-700 font-bold hover:underline">Dream Numbers Dictionary</a>.</li>
        </ul>
      </div>

      <!-- Quick FAQs -->
      <div class="border-t border-slate-100 pt-4 space-y-3">
        <h3 class="text-sm sm:text-base font-extrabold text-slate-900">
          Frequently Asked Questions (FAQs)
        </h3>
        <div class="space-y-2">
          <details class="bg-slate-50 border border-slate-200 rounded-xl p-3 cursor-pointer">
            <summary class="font-bold text-slate-800 text-xs sm:text-sm">Are Khanapara and Assam Teer the same game?</summary>
            <p class="mt-2 text-xs text-slate-600">Yes. Because Khanapara sits right along the border between Meghalaya and Assam, enthusiasts frequently refer to Khanapara Teer as Assam Teer, Guwahati Teer, or Assam Meghalaya Teer.</p>
          </details>
          <details class="bg-slate-50 border border-slate-200 rounded-xl p-3 cursor-pointer">
            <summary class="font-bold text-slate-800 text-xs sm:text-sm">Where can I get Khanapara Teer hit number alerts?</summary>
            <p class="mt-2 text-xs text-slate-600">You can get instant Khanapara Teer 1st Round (4:00 PM) and 2nd Round (4:30 PM) verified hit numbers directly on your phone by joining our official Telegram Channel or using our live board 1-click share button to forward scores directly to your groups.</p>
          </details>
          <details class="bg-slate-50 border border-slate-200 rounded-xl p-3 cursor-pointer">
            <summary class="font-bold text-slate-800 text-xs sm:text-sm">What happens if rain delays the shooting?</summary>
            <p class="mt-2 text-xs text-slate-600">Archers shoot in light rain, but severe thunderstorms can delay declared numbers by 10 to 15 minutes until arrow counting finishes under sheltered pavilions.</p>
          </details>
        </div>
      </div>
    </section>
  </div>
</Layout>
