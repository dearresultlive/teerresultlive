---
import Layout from '../layouts/Layout.astro';
import liveData from '../data/teer_live_results.json';
import CommonNumbersCard from '../components/CommonNumbersCard';
import PreviousResultsTable from '../components/PreviousResultsTable';

const game = liveData.games.khanapara;
const todayDateStr = liveData.date.split('-').reverse().join('/');
---

<Layout
  title={`Khanapara Teer Result Today Live (${todayDateStr}) • FR (4:00 PM) & SR (4:30 PM) | Teer Result Live`}
  description={`Live Khanapara Teer result today for First Round and Second Round. Check authentic Assam Meghalaya border hit numbers, target common numbers, house and ending.`}
>
  <div class="space-y-6">
    <header class="bg-gradient-to-r from-slate-900 to-indigo-950 border border-emerald-500/30 rounded-2xl p-5 sm:p-7 text-white space-y-3">
      <div class="flex items-center justify-between">
        <h1 class="text-xl sm:text-2xl font-black text-emerald-400">
          Khanapara Teer Result Today Live • {todayDateStr}
        </h1>
        <span class="text-xs bg-emerald-500/20 text-emerald-400 font-bold border border-emerald-500/40 px-2.5 py-1 rounded-full">
          Live Update
        </span>
      </div>
      <p class="text-xs sm:text-sm text-slate-300">
        Conducted officially at Khanapara, Ri-Bhoi district on the Assam-Meghalaya border.
      </p>

      <!-- FR & SR Result Box -->
      <div class="grid grid-cols-2 gap-3 pt-2 max-w-md">
        <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-3 text-center">
          <span class="text-xs font-bold text-slate-400 block uppercase">1st Round (4:00 PM)</span>
          <span class="text-3xl sm:text-4xl font-black font-mono text-amber-400 mt-1 block">
            {game.fr}
          </span>
        </div>
        <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-3 text-center">
          <span class="text-xs font-bold text-slate-400 block uppercase">2nd Round (4:30 PM)</span>
          <span class="text-3xl sm:text-4xl font-black font-mono text-emerald-400 mt-1 block">
            {game.sr}
          </span>
        </div>
      </div>
    </header>

    <CommonNumbersCard client:visible />
    <PreviousResultsTable client:visible />
  </div>
</Layout>
