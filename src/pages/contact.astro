---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us • Teer Result Live"
  description="Contact the editorial team at Teer Result Live. Inquiries, feedback, data corrections, and official correspondence."
>
  <div class="bg-white border border-slate-200/90 rounded-2xl p-6 sm:p-8 text-slate-700 space-y-6 leading-relaxed text-xs sm:text-sm shadow-xs">
    
    <header class="border-b border-slate-100 pb-4">
      <h1 class="text-xl sm:text-2xl font-black text-slate-900 flex items-center gap-2">
        <span>📬</span>
        <span>Contact Teer Result Live</span>
      </h1>
      <p class="text-slate-500 mt-1">
        We value accuracy, transparency, and timely communication with our readers and archery enthusiasts.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      
      <!-- Editorial & Corrections -->
      <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-4 space-y-2">
        <h2 class="text-sm font-black text-slate-900 uppercase tracking-wide flex items-center gap-1.5">
          <span>📝</span>
          <span>Editorial &amp; Result Corrections</span>
        </h2>
        <p class="text-xs text-slate-600">
          If you spot any discrepancy in our live results or historical archive tables, please contact our real-time verification desk immediately.
        </p>
        <p class="text-xs font-bold text-amber-700">
          Email: <a href="mailto:corrections@teerresultlive.in" class="hover:underline">corrections@teerresultlive.in</a>
        </p>
      </div>

      <!-- General Inquiries & Media -->
      <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-4 space-y-2">
        <h2 class="text-sm font-black text-slate-900 uppercase tracking-wide flex items-center gap-1.5">
          <span>💼</span>
          <span>General &amp; Partnership Inquiries</span>
        </h2>
        <p class="text-xs text-slate-600">
          For press coverage, syndicated content queries, or general platform feedback:
        </p>
        <p class="text-xs font-bold text-amber-700">
          Email: <a href="mailto:contact@teerresultlive.in" class="hover:underline">contact@teerresultlive.in</a>
        </p>
      </div>

    </div>

    <!-- Operating Details & Office -->
    <div class="space-y-3 pt-2">
      <h2 class="text-sm sm:text-base font-bold text-slate-900">
        Reporting Desk &amp; Field Verification
      </h2>
      <p class="text-slate-600">
        Our field reporting team monitors archery outcomes directly from authorized grounds, including Polo Ground (Shillong, East Khasi Hills) and Khanapara (Assam-Meghalaya border).
      </p>
      <ul class="text-xs space-y-1.5 text-slate-600 font-medium">
        <li>• <strong>Operational Hours:</strong> Monday to Saturday, 9:00 AM – 12:00 AM IST (Closed on Sundays)</li>
        <li>• <strong>Response Time:</strong> Editorial queries are typically acknowledged within 24 to 48 hours.</li>
        <li>• <strong>Official Domain:</strong> <a href="https://teerresultlive.in" class="text-amber-700 font-bold hover:underline">https://teerresultlive.in</a></li>
      </ul>
    </div>

    <!-- Statutory Notice -->
    <div class="bg-amber-50/60 border border-amber-200/80 rounded-xl p-3.5 text-[11px] text-amber-900 leading-relaxed">
      <strong>Important Notice:</strong> Teer Result Live is an independent news reporting publication. We do not sell lottery tickets, accept bets, or operate archery contests. Please do not contact us to place wagers.
    </div>

  </div>
</Layout>
