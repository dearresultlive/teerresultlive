---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import MobileBottomNav from '../components/MobileBottomNav';
import PWAInstallBanner from '../components/PWAInstallBanner';
import { ONESIGNAL_CONFIG } from '../config/onesignal';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  publishDate?: string;
}

const { title, description, canonicalUrl, publishDate } = Astro.props;
const oneSignalAppId = ONESIGNAL_CONFIG.appId;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-slate-100 text-slate-900 antialiased">
  <SEOHead
    title={title}
    description={description}
    canonicalUrl={canonicalUrl}
    publishDate={publishDate}
  />
  <body class="min-h-screen flex flex-col bg-slate-100 font-sans selection:bg-amber-100 selection:text-amber-900 text-slate-900">
    <Header />
    <main class="flex-1 max-w-4xl w-full mx-auto px-3 sm:px-4 py-4 sm:py-6 space-y-4 sm:space-y-6 pb-24 md:pb-8">
      <slot />
    </main>
    <Footer />
    
    <!-- Floating App Install Banner (Appears after delay, 5-day dismiss cooldown) -->
    <PWAInstallBanner client:idle />
    
    <!-- Mobile Fixed Bottom Navigation Dock & Features Drawer -->
    <MobileBottomNav client:idle currentPath={Astro.url.pathname} />

    <!-- Early Intercept for PWA Install Prompt -->
    <script is:inline>
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        window.deferredPWAInstallPrompt = e;
      });
    </script>

    <!-- Safe Service Worker Registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => {
            console.warn('SW registration skipped:', err);
          });
        });
      }
    </script>

    <!-- OneSignal Web Push Integration -->
    <script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
    <script is:inline define:vars={{ oneSignalAppId }}>
      if (oneSignalAppId && oneSignalAppId.trim()) {
        window.OneSignalDeferred = window.OneSignalDeferred || [];
        OneSignalDeferred.push(async function(OneSignal) {
          await OneSignal.init({
            appId: oneSignalAppId.trim(),
            allowLocalhostAsSecureOrigin: true,
            slidedown: {
              prompts: [
                {
                  type: 'push',
                  autoPrompt: true,
                  text: {
                    actionMessage: 'Get instant live Teer results (1st & 2nd round) direct on your screen.',
                    acceptButton: 'Allow Alerts',
                    cancelButton: 'Later'
                  },
                  delay: {
                    pageViews: 1,
                    timeDelay: 5
                  }
                }
              ]
            }
          });

          // Automatically pop up push prompt to user after 5 seconds
          setTimeout(async () => {
            try {
              if (typeof OneSignal.Slidedown?.promptPush === 'function') {
                await OneSignal.Slidedown.promptPush();
              }
            } catch (e) {
              // Gracefully handle if user already opted in or dismissed
            }
          }, 5000);
        });
      }
    </script>
  </body>
</html>
